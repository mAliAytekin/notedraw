{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Knowledge Canvas",
  "version": "0.3.0",
  "identifier": "local.notedraw.knowledge-canvas",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Knowledge Canvas", "width": 1440, "height": 950, "minWidth": 800, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": ["app"], "icon": ["icons/icon.png", "icons/icon.icns"], "macOS": { "minimumSystemVersion": "11.0" } }
}
